# HGMEDIA LOCAL ENVIRONMENT TEMPLATE
# Sao chép file này thành .env và thay các giá trị change_me.

# PostgreSQL Data Warehouse
DWH_PG_HOST=localhost
DWH_PG_PORT=5432
DWH_PG_DB=data_warehouse
DWH_PG_USER=dev
DWH_PG_PASSWORD=change_me

# PostgreSQL container initialization
POSTGRES_USER=dev
POSTGRES_PASSWORD=change_me
POSTGRES_DB=data_warehouse

# MinIO client
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me

# MinIO container initialization
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# Google Sheet credential
GSHEET_CREDENTIALS_PATH=config/gsheet_service_account.json

# Odoo PostgreSQL source
ODOO_PG_HOST=change_me
ODOO_PG_PORT=5432
ODOO_PG_DB=odoo
ODOO_PG_USER=change_me
ODOO_PG_PASSWORD=change_me

# HG Stock PostgreSQL source
HGSTOCK_HOST=change_me
HGSTOCK_PORT=5432
HGSTOCK_DB=hgstock
HGSTOCK_USER=change_me
HGSTOCK_PASSWORD=change_me

# Editing Management SQL Server source
EDITING_HOST=change_me
EDITING_PORT=1433
EDITING_DB=editing-management
EDITING_USER=change_me
EDITING_PASSWORD=change_me

# Record Survey SQL Server source
RS_HOST=change_me
RS_PORT=1433
RS_USER=change_me
RS_PASSWORD=change_me

# Channel services SQL Server source
CHANNEL_HOST=change_me
CHANNEL_PORT=1433
CHANNEL_USER=change_me
CHANNEL_PASSWORD=change_me
CHANNEL_ACCOUNTANT_DB=channel.service.accountant
CHANNEL_CHANNEL_DB=channel.service.channel
CHANNEL_NETWORK_DB=channel.service.network
CHANNEL_ORGANIZATION_DB=channel.service.organization
CHANNEL_PROJECT_DB=channel.service.project
CHANNEL_RELATIONSHIP_DB=channel.service.relationship

# Elasticsearch source
ELASTIC_HOST=change_me
ELASTIC_USER=change_me
ELASTIC_PASSWORD=change_me

# Airflow local Docker environment
AIRFLOW_UID=50000

# Airflow metadata PostgreSQL (chỉ dùng trong mạng Docker local)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# Airflow UI/API
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_JWT_SECRET=change_me
